---
import BaseLayout from "../layouts/BaseLayout.astro";

// Your contact methods. Fill in `value` (what visitors see) and `href` (where it links).
// Examples of href: "mailto:you@example.com", "https://www.roblox.com/users/123/profile",
// "https://www.linkedin.com/in/yourname". Leave href as "" to show the item without a link,
// or delete an entry entirely to hide it.
const contacts = [
  { label: "Email", value: "worksplosion@gmail.com", href: "mailto:worksplosion@gmail.com" },
  { label: "Discord", value: "@Soulsplosion", href: "" },
  { label: "Roblox", value: "Soulsplosion", href: "https://www.roblox.com/users/817970896/profile" },
  { label: "LinkedIn", value: "Lauren Knill", href: "https://www.linkedin.com/in/laurenknill/" },
];
---

<BaseLayout title="Contact" sideBarActiveItemID="contact">
  <div class="pb-12 mt-5">
    <div class="text-3xl w-full font-bold mb-2">Contact</div>
    <p class="text-lg mb-8">
      Interested in working together or have a question? Feel free to reach out!
    </p>

    <ul class="flex flex-col gap-3">
      {
        contacts.map((c) => (
          <li class="rounded-lg border border-base-300 px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:gap-6">
            <span class="font-bold text-accent w-28 shrink-0">{c.label}</span>
            {c.href ? (
              <a class="link link-hover break-all" href={c.href} target="_blank" rel="noopener noreferrer">
                {c.value}
              </a>
            ) : (
              <span class="opacity-80 break-all">{c.value}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
